# Reverse-proxy .htaccess for the ERP domain.
#
# INSTALL: copy this file into the DocumentRoot of the domain/subdomain in
# Webuzo, then rename it to `.htaccess`. Find the docroot with:
#   grep -rn "ServerName your-domain.com" /usr/local/apps/apache/conf/
# or:
#   /usr/local/apps/apache/bin/httpd -S
#
# Requires mod_rewrite, mod_proxy and mod_proxy_http, plus
# AllowOverride FileInfo (Webuzo normally enables it). SELinux hosts also need:
#   setsebool -P httpd_can_network_connect 1
#
# Check modules:
#   /usr/local/apps/apache/bin/httpd -M | grep -E 'rewrite|proxy'
#
# Verify after installing:
#   curl -fsS http://127.0.0.1:8086/api/health
#   curl -sI -H 'Host: your-domain.com' http://127.0.0.1/ | head -1

RewriteEngine On

# Optional: force the Host header. Not needed - the ERP nginx uses
# `server_name _` and accepts any Host. Uncomment only if your app requires it.
# RequestHeader set Host "your-domain.com"

# Let ACME/Let's Encrypt challenges be served from disk by Apache, not proxied.
# Keep this or certificate renewals will fail.
RewriteCond %{REQUEST_URI} !^/\.well-known [NC]

# [P] = proxy through mod_proxy. NEVER use [R]: that would redirect the
# visitor's browser to 127.0.0.1:8086 on their own machine.
RewriteRule ^(.*)$ http://127.0.0.1:8086/$1 [P,L]
