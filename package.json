{
  "name": "marvel-software",
  "version": "1.0.0",
  "private": true,
  "description": "MarvelSoftware — one deployable business platform (CRM, HR, staff, leave, finance, inventory) with a shared REST API.",
  "workspaces": [
    "apps/web",
    "server",
    "packages/*"
  ],
  "scripts": {
    "install:all": "npm install --workspaces",
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "dev": "concurrently \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w web",
    "test": "npm run test -w server",
    "test:isolated": "node scripts/test-isolated.mjs",
    "migrate": "npm run migrate -w server",
    "seed": "npm run seed -w server"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "concurrently": "^9.0.1",
    "embedded-postgres": "^18.7.0-beta.19",
    "puppeteer-core": "^25.17.0",
    "typescript": "^5.6.0"
  }
}
