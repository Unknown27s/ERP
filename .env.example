# ---- Server ----------------------------------------------------------------
PORT=4000
APP_TIMEZONE=Asia/Kolkata
# Use a long random string in production (at least 32 characters).
JWT_SECRET=replace-with-a-long-random-secret

# ---- Database (PostgreSQL) -------------------------------------------------
# Single connection string. Prefer the pooled Supabase URL for the API and the
# direct URL for migrations/seeds if your provider gives you both.
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres
SUPABASE_DB_URL=postgresql://postgres:password@localhost:5432/postgres

# ---- Company branding (seeded into shop_settings on first run) -------------
COMPANY_NAME=MarvelSoftware
COMPANY_LEGAL_NAME=MarvelSoftware

# ---- Email (optional) ------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=MarvelSoftware
# Set to true to log mail instead of sending it (useful in development).
MAIL_DISABLED=true
