# ---- Docker host publication ----------------------------------------------
# Loopback-only port published by docker compose; Apache/Webuzo proxies to it.
# 8080-8085 are used by other apps on this server, so ERP uses 8086.
# Each co-hosted application must use a different port (8086-8099 reserved here).
ERP_PORT=8086

# ---- Server ----------------------------------------------------------------
PORT=4000
APP_TIMEZONE=Asia/Kolkata
# Use a long random string in production (at least 32 characters).
JWT_SECRET=replace-with-a-long-random-secret

# ---- Database (PostgreSQL) -------------------------------------------------
# Single connection string. Prefer the pooled Supabase URL for the API and the
# direct URL for migrations/seeds if your provider gives you both.
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres
SUPABASE_DB_URL=postgresql://postgres:password@localhost:5432/postgres

# ---- Company branding (seeded into shop_settings on first run) -------------
COMPANY_NAME=MarvelSoftware
COMPANY_LEGAL_NAME=MarvelSoftware

# ---- Sign-in preview roster (demo-only; opt in explicitly) -------------------
# The login page lists existing seeded accounts so a reviewer can click a card
# and sign in in one click. This exposes those preview credentials via the
# public /api/config endpoint. Never enable it on a deployment with real staff
# credentials; set PREVIEW_LOGIN=1 only on an isolated demo deployment.
PREVIEW_LOGIN=0
# Optional comma-separated override of which emails appear on the login screen.
PREVIEW_EMAILS=
# Optional email:password overrides, e.g. admin@x:Secret1,hr@x:Secret2.
PREVIEW_PASSWORDS=

# ---- Email (optional) ------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=MarvelSoftware
# Set to true to log mail instead of sending it (useful in development).
MAIL_DISABLED=true
